# Teksage Website — environment template
#
# Copy this file to `.env.local` in the same folder (project root) and adjust values.
# `.env.local` is gitignored — do not commit real URLs or secrets.
#
# Flutter uses `ApiEndpoint.mainUrl` (host:8000) + `/api` for REST — same paths as this site.
#
# --- Client-safe (bundled into the browser) ---
#
# Option A — Browser calls FastAPI directly (backend must allow CORS for this origin).
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
#
# Option B — Browser calls same-origin `/api/*` on Next.js; next.config.ts proxies to FastAPI (good for local dev).
NEXT_PUBLIC_API_BASE_URL=same-origin
#
# Where Next.js should proxy `/api/*` (server-side rewrite only — not exposed to the browser).
BACKEND_PROXY_TARGET=http://127.0.0.1:8000
#
# If you test on a physical phone/LAN like Flutter (`mainUrl = http://10.x.x.x:8000`), set both:
# NEXT_PUBLIC_API_BASE_URL=http://10.x.x.x:8000
# BACKEND_PROXY_TARGET=http://10.x.x.x:8000
#
# Never set NEXT_PUBLIC_API_BASE_URL to http://localhost:3000 — that is this Next app, not FastAPI (you will get 404 on /api/*).
#
# WebSocket (AI chat) — browsers cannot use Next.js `/api` rewrites for WS. When using same-origin REST,
# set this to your FastAPI origin (same host as BACKEND_PROXY_TARGET):
# NEXT_PUBLIC_WS_BASE_URL=http://127.0.0.1:8000
#
# --- Firebase Web Push Notifications ---
# Values are read at runtime (main app + /firebase-messaging-sw.js route). Do not commit real keys.
# Firebase Console → Project Settings → General → Your apps → Add Web app (or select existing).
# Copy the firebaseConfig object values below.
# Project: astroprompt-a675c  |  Sender ID: 483755133089
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBKmo-a-S7W2-gQr4uFTj9ryyKlEq1kcU0
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=astroprompt-a675c.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=astroprompt-a675c
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=astroprompt-a675c.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=483755133089
# App ID — Firebase Console → Project Settings → Your apps → Web app → App ID (1:483755133089:web:XXXX)
NEXT_PUBLIC_FIREBASE_APP_ID=your_web_app_id_here
# VAPID key — Firebase Console → Project Settings → Cloud Messaging → Web Push certificates → Generate key pair
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your_vapid_key_here
#
# --- Server-only (required for profile location autocomplete) ---
# Google Places API key — NOT exposed to the browser. Do NOT use NEXT_PUBLIC_ prefix.
# Use the same key as Flutter `lib/config/googlePlaces.dart`, or create a separate key in Google Cloud.
# GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
