# Teksage Website — environment template
#
# Copy this file to `.env.local` in the same folder (project root) and adjust values.
# `.env.local` is gitignored — do not commit real URLs or secrets.
#
# --- Client-safe (bundled into the browser) ---
# Public HTTP(S) origin of your Python backend. Use https in production.
# Must be a full URL with scheme, no trailing slash required.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
#
# --- Server-only (optional, future use) ---
# Add variables WITHOUT the NEXT_PUBLIC_ prefix for secrets (API keys, internal URLs).
# Read them only in Server Components, Route Handlers, or Server Actions — never in client code.
